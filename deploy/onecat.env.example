# 网关环境 (systemd unit 通过 EnvironmentFile 加载) —— 真实文件在 v100:/home/z/onecat/config/onecat.env, 权限 600
VLLM_API_KEY=<在服务器上生成, 不入库不入文档>
ONECAT_PORT=2223
ONECAT_UPSTREAM=http://127.0.0.1:8000
ONECAT_HOST=0.0.0.0

# 可选
# ONECAT_MAX_CONCURRENT=6        # 若设置, 必须与引擎 ONCAT_MAX_SEQS 一致
# ONECAT_MAX_QUEUE=10            # 排队上限
# ONECAT_QUEUE_TIMEOUT=120       # 排队超时秒数, 超时 429

# ---- 引擎容器环境 (v100:/home/z/onecat/config/tuned.env, compose env_file) ----
ONCAT_MAX_SEQS=6
ONCAT_BUDGET=8192
ONCAT_UTIL=0.80
ONCAT_MAX_MODEL_LEN=262144
